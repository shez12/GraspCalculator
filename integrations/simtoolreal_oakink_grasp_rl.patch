+
+Supports two backends:
+- "analytic": exact F1 * gate(F4p) * F4d scorer.
+- "transformer": distilled reference-conditioned Point Transformer scorer (fp16 GPU).
+
+Scoring trigger (controlled by cfg.reward.grasp_score_interval):
+- interval > 0: every `interval` simulation steps after reset (episode_length_buf % interval == 0).
+- interval <= 0: once when the object is first lifted.
+"""
+
+from __future__ import annotations
+
+import sys
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+import numpy as np
+import torch
+
+GRASP_TERMS = ("grasp_score", "grasp_f1", "grasp_f4p", "grasp_f4d", "grasp_scored")
+
+
+def _origin(el):
+    from scipy.spatial.transform import Rotation
+
+    T = np.eye(4)
+    o = el.find("origin")
+    if o is not None:
+        T[:3, :3] = Rotation.from_euler("xyz", [float(v) for v in o.get("rpy", "0 0 0").split()]).as_matrix()
+        T[:3, 3] = [float(v) for v in o.get("xyz", "0 0 0").split()]
+    return T
+
+
+def _object_points(urdf_path: str, n_pts: int, afford: int, other: int, seed: int = 0):
+    """Surface points / normals / part labels of an object URDF in its root-link frame."""
+    import trimesh
+    from graspcalc.objects import axis_part_labels
+
+    root = ET.parse(urdf_path).getroot()
+    meshes, primitive = [], True
+    for c in root.iter("collision"):
+        g = c.find("geometry")
+        if g.find("box") is not None:
+            m = trimesh.creation.box(extents=[float(v) for v in g.find("box").get("size").split()])
+        elif g.find("cylinder") is not None:
+            cy = g.find("cylinder")
+            m = trimesh.creation.cylinder(radius=float(cy.get("radius")), height=float(cy.get("length")))
+        elif g.find("sphere") is not None:
+            m = trimesh.creation.icosphere(radius=float(g.find("sphere").get("radius")))
+        elif g.find("mesh") is not None:
+            me = g.find("mesh")
+            m = trimesh.load(str(Path(urdf_path).parent / me.get("filename")), force="mesh")
+            if me.get("scale"):
+                m.apply_scale([float(v) for v in me.get("scale").split()])
+            primitive = False
+        else:
+            continue
+        m.apply_transform(_origin(c))
+        meshes.append(m)
+    merged = trimesh.util.concatenate(meshes)
+    face_part = np.concatenate([np.full(len(m.faces), i) for i, m in enumerate(meshes)])
+    pts, fi = trimesh.sample.sample_surface(merged, n_pts, seed=seed)
+    nrm = merged.face_normals[fi]
+    if primitive and len(meshes) == 2:
+        lab = np.where(face_part[fi] == 0, afford, other)
+    elif primitive:
+        lab = np.full(n_pts, afford)
+    else:
+        lab = np.where(axis_part_labels(pts) == 1, other, afford)
+    return pts, nrm, lab
+
+
+def _quat_to_mat(q):  # (..., 4) wxyz -> (..., 3, 3)
+    w, x, y, z = q.unbind(-1)
+    return torch.stack(
+        [
+            1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w),
+            2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w),
+            2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y),
+        ],
+        -1,
+    ).view(*q.shape[:-1], 3, 3)
+
+
+def init_grasp_scorer(env) -> None:
+    """Called once after allocate_state_buffers. No-op unless ref or ref_dir is set."""
+    rew = env.cfg.reward
+    env._grasp_scorer = None
+    env._grasp_scorers_by_cat = None
+    env._grasp_asset_cat_ids = None
+    env._grasp_backend = "analytic"
+    env._grasp_terms = {k: torch.zeros(env.num_envs, device=env.device) for k in GRASP_TERMS}
+    ref_dir = getattr(rew, "grasp_score_ref_dir", "")
+    if not rew.grasp_score_ref and not ref_dir:
+        return
+    if rew.graspcalc_root not in sys.path:
+        sys.path.insert(0, rew.graspcalc_root)
+    from graspcalc.hands import URDFHand
+    from graspcalc.robots import sharpa_ha4
+
+    repo_root = Path(__file__).resolve().parents[4]
+    robot_urdf = Path(env.cfg.assets.robot_urdf)
+    robot_urdf = robot_urdf if robot_urdf.is_absolute() else repo_root / robot_urdf
+    env._grasp_hand = URDFHand(sharpa_ha4("left", urdf_path=str(robot_urdf)), device=env.device)
+
+    backend = getattr(rew, "grasp_score_backend", "analytic")
+    env._grasp_backend = backend
+    if backend == "transformer":
+        from graspcalc.transformer_scorer import TransformerGraspScorer
+
+        ckpt = getattr(rew, "grasp_score_transformer_ckpt", "")
+        if not ckpt:
+            raise ValueError("grasp_score_backend='transformer' requires grasp_score_transformer_ckpt")
+        env._grasp_scorer = TransformerGraspScorer.from_checkpoint(
+            ckpt_path=ckpt,
+            ref_path=rew.grasp_score_ref,
+            afford_parts=(rew.grasp_score_afford_part,),
+            device=env.device,
+            use_fp16=True,
+        )
+        vocab = [rew.grasp_score_afford_part, "other"]
+        afford, other = 0, 1
+    elif ref_dir:
+        if backend == "invariant_v2":
+            from graspcalc.invariant_scorer import InvariantGraspScorer as _ScorerCls
+        else:
+            from graspcalc.scorer import GraspScorer as _ScorerCls
+
+        asset_clouds = getattr(env, "_asset_clouds", None)
+        if asset_clouds is None or "categories" not in asset_clouds:
+            raise ValueError("grasp_score_ref_dir requires dataset_manifest with per-asset categories")
+        ref_dir_p = Path(ref_dir)
+        scorers_by_cat = {}
+        for cid, cname in enumerate(asset_clouds["categories"]):
+            cand = ref_dir_p / f"{cname}.pt"
+            if not cand.exists():
+                if rew.grasp_score_ref:
+                    cand = Path(rew.grasp_score_ref)
+                else:
+                    raise FileNotFoundError(f"Missing per-category ref for '{cname}': {cand}")
+            scorers_by_cat[cid] = _ScorerCls.from_file(
+                str(cand),
+                [rew.grasp_score_afford_part],
+                device=env.device,
+                chunk=rew.grasp_score_chunk,
+            )
+        env._grasp_scorers_by_cat = scorers_by_cat
+        env._grasp_asset_cat_ids = asset_clouds["category_id"].to(env.device, dtype=torch.long)
+        env._grasp_scorer = scorers_by_cat[0]
+        vocab = env._grasp_scorer.vocab
+        afford = vocab.index(rew.grasp_score_afford_part)
+        other = next(i for i in range(len(vocab)) if i != afford)
+    else:
+        if backend == "invariant_v2":
+            from graspcalc.invariant_scorer import InvariantGraspScorer as _ScorerCls
+        else:
+            from graspcalc.scorer import GraspScorer as _ScorerCls
+
+        env._grasp_scorer = _ScorerCls.from_file(
+            rew.grasp_score_ref,
+            [rew.grasp_score_afford_part],
+            device=env.device,
+            chunk=rew.grasp_score_chunk,
+        )
+        vocab = env._grasp_scorer.vocab
+        afford = vocab.index(rew.grasp_score_afford_part)
+        other = next(i for i in range(len(vocab)) if i != afford)
+
+    # Prefer pre-cached OakInk asset clouds when dataset_manifest was used
+    asset_clouds = getattr(env, "_asset_clouds", None)
+    if asset_clouds is not None:
+        pts = asset_clouds["points"].to(env.device, dtype=torch.float32)
+        nrm = asset_clouds["normals"].to(env.device, dtype=torch.float32)
+        aff = asset_clouds["afford_mask"].to(env.device, dtype=torch.float32)
+        env._grasp_obj_pts = pts
+        env._grasp_obj_nrm = nrm
+        env._grasp_obj_aff = aff
+        env._grasp_obj_lab = torch.where(aff > 0.5, torch.full_like(aff, afford, dtype=torch.long), torch.full_like(aff, other, dtype=torch.long))
+        n_assets = pts.shape[0]
+    else:
+        P, N, L = [], [], []
+        for path in env._object_urdf_paths:
+            p, n, l = _object_points(path, rew.grasp_score_obj_pts, afford, other)
+            P.append(p), N.append(n), L.append(l)
+        env._grasp_obj_pts = torch.tensor(np.stack(P), dtype=torch.float32, device=env.device)
+        env._grasp_obj_nrm = torch.tensor(np.stack(N), dtype=torch.float32, device=env.device)
+        env._grasp_obj_lab = torch.tensor(np.stack(L), dtype=torch.long, device=env.device)
+        env._grasp_obj_aff = (env._grasp_obj_lab == afford).float()
+        n_assets = len(P)
+
+    env._grasp_body_names = list(env.robot.body_names)
+
+    # Pre-cache 39-dim morphology-invariant ref feature table (R, 39) & per-env ref index (N,)
+    # for goal-conditioned policy/critic observations (supports future multi-ref sampling per object).
+    if env._grasp_scorers_by_cat:
+        num_refs = len(env._grasp_scorers_by_cat)
+        feats = []
+        for cid in range(num_refs):
+            sc = env._grasp_scorers_by_cat[cid]
+            if hasattr(sc, "ref_feature_vector"):
+                feats.append(sc.ref_feature_vector().to(device=env.device, dtype=torch.float32))
+            else:
+                feats.append(torch.zeros(39, device=env.device, dtype=torch.float32))
+        env._grasp_ref_feats = torch.stack(feats, dim=0)  # (R, 39)
+        env._grasp_env_ref_ids = env._grasp_asset_cat_ids[env._object_asset_index_per_env].clone()
+    elif env._grasp_scorer is not None and hasattr(env._grasp_scorer, "ref_feature_vector"):
+        env._grasp_ref_feats = env._grasp_scorer.ref_feature_vector().to(device=env.device, dtype=torch.float32).unsqueeze(0)
+        env._grasp_env_ref_ids = torch.zeros(env.num_envs, dtype=torch.long, device=env.device)
+    else:
+        env._grasp_ref_feats = torch.zeros((1, 39), device=env.device, dtype=torch.float32)
+        env._grasp_env_ref_ids = torch.zeros(env.num_envs, dtype=torch.long, device=env.device)
+
+    interval = getattr(rew, "grasp_score_interval", 0)
+    trig = f"every {interval} steps" if interval > 0 else "at first lift"
+    ref_desc = f"dir:{ref_dir} ({len(env._grasp_scorers_by_cat)} cats)" if env._grasp_scorers_by_cat else rew.grasp_score_ref
+    print(
+        f"[grasp_score] backend={backend} ref={ref_desc} "
+        f"afford='{rew.grasp_score_afford_part}' trigger=({trig}) "
+        f"assets={n_assets} scale={rew.grasp_score_rew_scale} pre_lift_mult={getattr(rew, 'grasp_score_pre_lift_mult', 1.0)}"
+    )
+
+
+def _score_single_group(env, scorer, sub_ids: torch.Tensor) -> dict[str, torch.Tensor]:
+    B = len(sub_ids)
+    pos = env.robot.data.body_link_pos_w[sub_ids]
+    rot = _quat_to_mat(env.robot.data.body_link_quat_w[sub_ids])
+    link_T = {}
+    for i, name in enumerate(env._grasp_body_names):
+        T = torch.eye(4, device=env.device).repeat(B, 1, 1)
+        T[:, :3, :3], T[:, :3, 3] = rot[:, i], pos[:, i]
+        link_T[name] = T
+    hand = env._grasp_hand.from_link_poses(link_T)
+    asset = env._object_asset_index_per_env[sub_ids]
+    Ro = _quat_to_mat(env.object.data.root_quat_w[sub_ids])
+    po = env.object.data.root_pos_w[sub_ids]
+    obj = torch.einsum("bij,bmj->bmi", Ro, env._grasp_obj_pts[asset]) + po[:, None]
+    with torch.no_grad():
+        if env._grasp_backend == "transformer":
+            return scorer.score(hand, env._grasp_hand.palm_normal_sign, obj, env._grasp_obj_aff[asset])
+        obj_n = torch.einsum("bij,bmj->bmi", Ro, env._grasp_obj_nrm[asset])
+        return scorer.score(hand, env._grasp_hand.palm_normal_sign, obj, obj_n, env._grasp_obj_lab[asset])
+
+
+def score_grasps(env, env_ids: torch.Tensor) -> dict[str, torch.Tensor]:
+    """Scores the current hand pose of env_ids against the reference (per-category if ref_dir is set)."""
+    B_all = len(env_ids)
+    if getattr(env, "_grasp_scorers_by_cat", None):
+        out = {k: torch.zeros(B_all, device=env.device, dtype=torch.float32) for k in ("total", "f1", "f4p", "f4d")}
+        cat_ids = env._grasp_env_ref_ids[env_ids]
+        for cid in torch.unique(cat_ids).tolist():
+            mask = cat_ids == cid
+            r = _score_single_group(env, env._grasp_scorers_by_cat[int(cid)], env_ids[mask])
+            for k in out:
+                out[k][mask] = r[k].float()
+        return out
+
+    chunk_sz = 512 if env._grasp_backend == "transformer" else B_all
+    outs: dict[str, list[torch.Tensor]] = {"total": [], "f1": [], "f4p": [], "f4d": []}
+    for start in range(0, B_all, chunk_sz):
+        r = _score_single_group(env, env._grasp_scorer, env_ids[start : start + chunk_sz])
+        for k in outs:
+            outs[k].append(r[k])
+    return {k: torch.cat(v, dim=0) for k, v in outs.items()}
+
+
+def grasp_score_reward(env, score_mask: torch.Tensor) -> torch.Tensor:
+    """(N,) reward; also fills env._grasp_terms (raw score terms, non-zero only on scored steps)."""
+    for v in env._grasp_terms.values():
+        v.zero_()
+    rew = torch.zeros(env.num_envs, device=env.device)
+    if env._grasp_scorer is None:
+        return rew
+    ids = score_mask.nonzero(as_tuple=False).squeeze(-1)
+    if len(ids) == 0:
+        return rew
+    r = score_grasps(env, ids)
+    for key, src in (("grasp_score", "total"), ("grasp_f1", "f1"), ("grasp_f4p", "f4p"), ("grasp_f4d", "f4d")):
+        env._grasp_terms[key][ids] = r[src]
+    env._grasp_terms["grasp_scored"][ids] = 1.0
+    env.extras["grasp_score_at_lift"] = float(r["total"].mean())
+    pre_mult = float(getattr(env.cfg.reward, "grasp_score_pre_lift_mult", 1.0))
+    if pre_mult != 1.0 and hasattr(env, "_lifted_object"):
+        lifted = env._lifted_object[ids]
+        mult = torch.where(lifted, torch.ones_like(r["total"]), torch.full_like(r["total"], pre_mult))
+        rew[ids] = env.cfg.reward.grasp_score_rew_scale * mult * r["total"]
+    else:
+        rew[ids] = env.cfg.reward.grasp_score_rew_scale * r["total"]
+    return rew
