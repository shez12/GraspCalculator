diff --git a/isaacsimenvs/utils/cat_advantage.py b/isaacsimenvs/utils/cat_advantage.py
new file mode 100644
index 00000000..3c810c3f
--- /dev/null
+++ b/isaacsimenvs/utils/cat_advantage.py
@@ -0,0 +1,188 @@
+"""Per-category GAE Advantage normalization and per-category Critic diagnostics.
+
+Hooks into RL-Games `ContinuousA2CBase` without modifying external `rl_games`:
+- `play_steps`: attaches `batch_dict["cat_ids"]` of shape `(N * T,)` so SAPG's
+  `augment_batch_for_mixed_expl` and `shuffle_batch` automatically keep category
+  IDs aligned 1-to-1 with `returns`, `values`, and `advantages`.
+- `prepare_dataset`:
+  1. Actor side: replaces global advantage normalization with per-category
+     group normalization:
+         A_hat_i = clamp((A_i - mu_{c(i)}) / max(sigma_{c(i)}, floor_ratio * sigma_global), -clip, clip)
+     with NO global re-scaling afterward.
+  2. Critic side: leaves critic loss untouched, and logs per-category
+     `value_loss_cat/<cat>`, `explained_var_cat/<cat>`, and raw `adv_std_cat/<cat>`
+     to TensorBoard every epoch.
+"""
+from __future__ import annotations
+
+import functools
+import torch
+
+
+def _resolve_env_categories(env) -> tuple[torch.Tensor | None, list[str]]:
+    raw = getattr(env, "unwrapped", env)
+    cats = list(getattr(raw, "_asset_categories", []) or [])
+    cat_ids_per_asset = getattr(
+        raw, "_grasp_asset_cat_ids", getattr(raw, "_asset_category_ids", None)
+    )
+    obj_idx = getattr(raw, "_object_asset_index_per_env", None)
+    if not cats or cat_ids_per_asset is None or obj_idx is None:
+        return None, []
+    env_cat_ids = cat_ids_per_asset[obj_idx].to(dtype=torch.long)
+    return env_cat_ids, cats
+
+
+def install_per_cat_advantage_hook(
+    env,
+    *,
+    floor_ratio: float = 0.2,
+    clip_val: float = 8.0,
+) -> bool:
+    """Install per-category advantage normalization + critic diagnostics on ContinuousA2CBase."""
+    env_cat_ids, categories = _resolve_env_categories(env)
+    if env_cat_ids is None or len(categories) <= 1:
+        print(
+            "[cat_advantage] Skipping install (single-category or no asset categories found).",
+            flush=True,
+        )
+        return False
+
+    from rl_games.common.a2c_common import ContinuousA2CBase
+
+    if getattr(ContinuousA2CBase, "_per_cat_adv_hooked", False):
+        return True
+
+    orig_play_steps = ContinuousA2CBase.play_steps
+    orig_prepare_dataset = ContinuousA2CBase.prepare_dataset
+
+    @functools.wraps(orig_play_steps)
+    def wrapped_play_steps(self, *args, **kwargs):
+        batch_dict, extras = orig_play_steps(self, *args, **kwargs)
+        n_envs = int(env_cat_ids.numel())
+        total_rows = int(batch_dict["returns"].shape[0])
+        if n_envs > 0 and total_rows % n_envs == 0:
+            horizon = total_rows // n_envs
+            # swap_and_flatten01 maps (T, N) -> (N, T) -> (N * T,), so env i occupies [i*T : (i+1)*T]
+            cids = (
+                env_cat_ids.to(device=batch_dict["returns"].device)
+                .unsqueeze(1)
+                .expand(n_envs, horizon)
+                .reshape(total_rows)
+            )
+            batch_dict["cat_ids"] = cids
+        return batch_dict, extras
+
+    @functools.wraps(orig_prepare_dataset)
+    def wrapped_prepare_dataset(self, batch_dict, train_value_mean_std=True):
+        cat_ids = batch_dict.pop("cat_ids", None)
+        if cat_ids is None or not self.normalize_advantage:
+            return orig_prepare_dataset(self, batch_dict, train_value_mean_std=train_value_mean_std)
+
+        obses = batch_dict["obses"]
+        returns = batch_dict["returns"]
+        dones = batch_dict["dones"]
+        values = batch_dict["values"]
+        actions = batch_dict["actions"]
+        neglogpacs = batch_dict["neglogpacs"]
+        mus = batch_dict["mus"]
+        sigmas = batch_dict["sigmas"]
+        rnn_states = batch_dict.get("rnn_states", None)
+        rnn_masks = batch_dict.get("rnn_masks", None)
+
+        advantages = returns - values
+
+        if self.normalize_value:
+            if train_value_mean_std:
+                self.value_mean_std.train()
+            values = self.value_mean_std(values)
+            returns = self.value_mean_std(returns)
+            self.value_mean_std.eval()
+
+        advantages = torch.sum(advantages, axis=1)
+
+        with torch.no_grad():
+            if rnn_masks is not None:
+                valid = rnn_masks.reshape(-1) > 0
+            else:
+                valid = torch.ones_like(advantages, dtype=torch.bool)
+
+            valid_adv = advantages[valid]
+            sigma_global = (
+                valid_adv.std(unbiased=False)
+                if valid_adv.numel() > 1
+                else torch.tensor(1.0, device=advantages.device, dtype=advantages.dtype)
+            )
+            sigma_floor = floor_ratio * sigma_global
+
+            adv_norm = torch.zeros_like(advantages)
+            v_pred_1d = values.reshape(-1)
+            v_ret_1d = returns.reshape(-1)
+            writer = getattr(self, "writer", None)
+            frame = int(getattr(self, "frame", 0))
+
+            for cid, cname in enumerate(categories):
+                m = (cat_ids == cid) & valid
+                if not m.any():
+                    continue
+                a_c = advantages[m]
+                mu_c = a_c.mean()
+                sigma_c = a_c.std(unbiased=False) if a_c.numel() > 1 else torch.zeros_like(mu_c)
+                denom_c = torch.maximum(sigma_c, sigma_floor) + 1e-8
+                norm_c = (a_c - mu_c) / denom_c
+                if clip_val > 0.0:
+                    norm_c = norm_c.clamp(-clip_val, clip_val)
+                adv_norm[m] = norm_c
+
+                if writer is not None:
+                    vp_c = v_pred_1d[m]
+                    vr_c = v_ret_1d[m]
+                    err_c = vr_c - vp_c
+                    v_loss_c = 0.5 * (err_c * err_c).mean().item()
+                    var_ret_c = vr_c.var(unbiased=False).item()
+                    var_err_c = err_c.var(unbiased=False).item()
+                    exp_var_c = 1.0 - var_err_c / (var_ret_c + 1e-8)
+                    writer.add_scalar(f"value_loss_cat/{cname}", float(v_loss_c), frame)
+                    writer.add_scalar(f"explained_var_cat/{cname}", float(exp_var_c), frame)
+                    writer.add_scalar(f"adv_std_cat/{cname}", float(sigma_c.item()), frame)
+
+            if writer is not None:
+                writer.add_scalar("adv_std_global", float(sigma_global.item()), frame)
+
+        dataset_dict = {
+            "old_values": values,
+            "old_logp_actions": neglogpacs,
+            "advantages": adv_norm,
+            "returns": returns,
+            "actions": actions,
+            "obs": obses,
+            "dones": dones,
+            "rnn_states": rnn_states,
+            "rnn_masks": rnn_masks,
+            "mu": mus,
+            "sigma": sigmas,
+            "off_policy_mask": batch_dict.get("off_policy_mask", None),
+        }
+        self.dataset.update_values_dict(dataset_dict)
+
+        if self.has_central_value:
+            cv_dict = {
+                "old_values": values,
+                "advantages": adv_norm,
+                "returns": returns,
+                "actions": actions,
+                "obs": batch_dict["states"],
+                "dones": dones,
+                "rnn_masks": rnn_masks,
+            }
+            self.central_value_net.update_dataset(cv_dict)
+
+    ContinuousA2CBase.play_steps = wrapped_play_steps
+    ContinuousA2CBase.prepare_dataset = wrapped_prepare_dataset
+    ContinuousA2CBase._per_cat_adv_hooked = True
+    print(
+        f"[cat_advantage] Installed per-category GAE advantage norm "
+        f"(cats={len(categories)}, floor={floor_ratio}*sigma_global, clip={clip_val}) "
+        f"+ per-cat critic diagnostics (value_loss_cat / explained_var_cat / adv_std_cat).",
+        flush=True,
+    )
+    return True
diff --git a/isaacsimenvs/utils/pointnet_network.py b/isaacsimenvs/utils/pointnet_network.py
new file mode 100644
index 00000000..7374ba60
--- /dev/null
+++ b/isaacsimenvs/utils/pointnet_network.py
@@ -0,0 +1,120 @@
+"""End-to-end PointNet Actor-Critic network builder for RL-Games (PPO & SAPG).
+
+Expects a flat observation vector laid out as:
+    [proprio (D_p) | object_pointcloud (N * C) | optional SAPG tail (D_t)]
+where `object_pointcloud` is placed as the LAST field of `obs_list` / `state_list`,
+and SAPG optionally appends its 1-column `pid_idx` / `coef_id_idx` at the very end.
+
+In `forward()`:
+  1. Slices out `proprio`, `cloud (B, N, C)`, and optional `tail`.
+  2. Encodes `cloud` with a permutation-invariant PointNet (shared MLP + MaxPool).
+  3. Applies LayerNorm to `proprio` (so `normalize_input: False` can be used without
+     breaking PointNet permutation invariance).
+  4. Concatenates `[proprio_norm, geo_feat, tail]` and delegates to `A2CBuilder.Network`
+     (LSTM + MLP + mu/sigma/value, including SAPG `extra_param` & `coef_cond`).
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.nn as nn
+
+from rl_games.algos_torch.model_builder import register_network
+from rl_games.algos_torch.network_builder import A2CBuilder
+
+
+class PointNetEncoder(nn.Module):
+    def __init__(self, in_dim: int, units: list[int], out_dim: int):
+        super().__init__()
+        layers: list[nn.Module] = []
+        prev = in_dim
+        for h in units:
+            layers.append(nn.Linear(prev, h))
+            layers.append(nn.LayerNorm(h))
+            layers.append(nn.ELU(inplace=True))
+            prev = h
+        if prev != out_dim:
+            layers.append(nn.Linear(prev, out_dim))
+            layers.append(nn.LayerNorm(out_dim))
+            layers.append(nn.ELU(inplace=True))
+        self.mlp = nn.Sequential(*layers)
+
+    def forward(self, pts: torch.Tensor) -> torch.Tensor:
+        # pts: (B, N, C) -> (B, out_dim)
+        feat = self.mlp(pts)
+        return feat.max(dim=1).values
+
+
+class PointNetA2CBuilder(A2CBuilder):
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+
+    def load(self, params):
+        self.params = params
+
+    class Network(A2CBuilder.Network):
+        def __init__(self, params, **kwargs):
+            pn_cfg = params.get("pointnet", {})
+            self.pn_num_points = int(pn_cfg.get("num_points", 128))
+            self.pn_point_dim = int(pn_cfg.get("point_dim", 7))
+            self.pn_units = list(pn_cfg.get("units", [64, 128, 128]))
+            self.pn_out_dim = int(pn_cfg.get("out_dim", 128))
+            self.pn_flat_dim = self.pn_num_points * self.pn_point_dim
+
+            orig_shape = kwargs["input_shape"]
+            orig_dim = int(orig_shape[0])
+
+            # SAPG appends 1 column at the end (`pid_idx` / `coef_id_idx`) when present
+            has_pid = "pid_idx" in kwargs and kwargs["pid_idx"] is not None
+            has_coef = "coef_id_idx" in kwargs and kwargs["coef_id_idx"] is not None
+            tail_dim = 0
+            if has_pid:
+                tail_dim = max(tail_dim, orig_dim - int(kwargs["pid_idx"]))
+            if has_coef:
+                tail_dim = max(tail_dim, orig_dim - int(kwargs["coef_id_idx"]))
+
+            self.pn_proprio_dim = orig_dim - self.pn_flat_dim - tail_dim
+            if self.pn_proprio_dim < 0:
+                raise ValueError(
+                    f"PointNetA2CBuilder: input_shape={orig_shape} smaller than "
+                    f"pointcloud flat dim {self.pn_flat_dim} + tail {tail_dim}"
+                )
+
+            delta = self.pn_out_dim - self.pn_flat_dim
+            new_kwargs = dict(kwargs)
+            new_kwargs["input_shape"] = (orig_dim + delta,)
+            if has_pid:
+                new_kwargs["pid_idx"] = int(kwargs["pid_idx"]) + delta
+            if has_coef:
+                new_kwargs["coef_id_idx"] = int(kwargs["coef_id_idx"]) + delta
+
+            super().__init__(params, **new_kwargs)
+
+            self.proprio_ln = nn.LayerNorm(self.pn_proprio_dim)
+            self.pointnet = PointNetEncoder(self.pn_point_dim, self.pn_units, self.pn_out_dim)
+
+        def forward(self, obs_dict):
+            obs = obs_dict["obs"]
+            bsz = obs.shape[0]
+            p_end = self.pn_proprio_dim
+            c_end = p_end + self.pn_flat_dim
+
+            proprio = self.proprio_ln(obs[:, :p_end])
+            cloud = obs[:, p_end:c_end].reshape(bsz, self.pn_num_points, self.pn_point_dim)
+            geo = self.pointnet(cloud)
+
+            if c_end < obs.shape[1]:
+                tail = obs[:, c_end:]
+                packed = torch.cat([proprio, geo, tail], dim=-1)
+            else:
+                packed = torch.cat([proprio, geo], dim=-1)
+
+            new_obs_dict = dict(obs_dict)
+            new_obs_dict["obs"] = packed
+            return super().forward(new_obs_dict)
+
+    def build(self, name, **kwargs):
+        return PointNetA2CBuilder.Network(self.params, **kwargs)
+
+
+register_network("pointnet_actor_critic", PointNetA2CBuilder)
