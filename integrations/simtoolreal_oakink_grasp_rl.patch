+def _compute_asset_s_ax(pts: torch.Tensor, aff: torch.Tensor) -> torch.Tensor:
+    """Compute per-point normalized 1D functional-axis coordinate s_ax in (A, M, 1).
+    Matches invariant_scorer.py: axis = normalize(mean_other - mean_afford), normalized
+    by the 5%-95% affordance span (defaults to 0.5 when no axis is defined).
+    """
+    aff_bool = aff.squeeze(-1) > 0.5  # (A, M)
+    oth_bool = ~aff_bool
+    aff_cnt = aff_bool.sum(dim=-1)
+    oth_cnt = oth_bool.sum(dim=-1)
+    has_axis = (aff_cnt > 4) & (oth_cnt > 4)
+
+    aff_f = aff_bool.float().unsqueeze(-1)
+    oth_f = oth_bool.float().unsqueeze(-1)
+    aff_mean = (pts * aff_f).sum(dim=1) / aff_cnt.clamp(min=1).float().unsqueeze(-1)
+    oth_mean = (pts * oth_f).sum(dim=1) / oth_cnt.clamp(min=1).float().unsqueeze(-1)
+    axis_v = oth_mean - aff_mean
+    axis_norm = torch.norm(axis_v, dim=-1)
+    has_axis = has_axis & (axis_norm > 1e-3)
+    a_hat = axis_v / axis_norm.clamp(min=1e-6).unsqueeze(-1)  # (A, 3)
+
+    proj = (pts * a_hat.unsqueeze(1)).sum(dim=-1)  # (A, M)
+    big = 1e6
+    proj_min = proj.masked_fill(~aff_bool, big).min(dim=-1).values
+    proj_max = proj.masked_fill(~aff_bool, -big).max(dim=-1).values
+    raw_span = (proj_max - proj_min).clamp(min=0.02)
+    p_lo = proj_min + 0.05 * raw_span
+    p_hi = proj_max - 0.05 * raw_span
+    span = (p_hi - p_lo).clamp(min=0.02)
+    s_ax = ((proj - p_lo.unsqueeze(-1)) / span.unsqueeze(-1)).clamp(-1.0, 2.0)
+    s_ax = torch.where(has_axis.unsqueeze(-1), s_ax, torch.full_like(s_ax, 0.5))
+    return s_ax.unsqueeze(-1).contiguous()
+
+
+def _ensure_obs_pointcloud_buffers(env) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Lazily prepare (A, 128, 3) local points, (A, 128, 1) affordance masks, and (A, 128, 1) s_ax on GPU."""
+    pts = getattr(env, "_obs_asset_pts", None)
+    aff = getattr(env, "_obs_asset_afford", None)
+    sax = getattr(env, "_obs_asset_s_ax", None)
+    if pts is not None and aff is not None and sax is not None:
+        return pts, aff, sax
+    n_pts = 128
+    clouds = getattr(env, "_asset_clouds", None)
+    if clouds is not None:
+        raw_pts = clouds["points"]       # (A, M, 3)
+        raw_aff = clouds["afford_mask"]  # (A, M)
+        m = raw_pts.shape[1]
+        idx = torch.linspace(0, m - 1, n_pts).long()
+        pts = raw_pts[:, idx].to(device=env.device, dtype=torch.float32).contiguous()
+        aff = raw_aff[:, idx].unsqueeze(-1).to(device=env.device, dtype=torch.float32).contiguous()
+    else:
+        # Fallback for procedural / single-URDF eval: sample 128 pts from each URDF
+        import trimesh, numpy as np, xml.etree.ElementTree as ET
+        from pathlib import Path
+        all_p, all_a = [], []
+        for upath in env._object_urdf_paths:
+            u = Path(upath)
+            tree = ET.parse(u)
+            meshes = []
+            for m_el in tree.findall(".//visual/geometry/mesh") or tree.findall(".//collision/geometry/mesh"):
+                fn = m_el.get("filename")
+                if fn:
+                    mp = u.parent / fn
+                    if mp.exists():
+                        meshes.append(trimesh.load(mp, force="mesh", process=False))
+            if meshes:
+                comb = trimesh.util.concatenate(meshes)
+                sp, _ = trimesh.sample.sample_surface(comb, n_pts)
+                sp = np.asarray(sp, dtype=np.float32)
+            else:
+                sp = np.zeros((n_pts, 3), dtype=np.float32)
+            all_p.append(sp)
+            # Heuristic affordance: x <= 0 is handle in canonical/DexToolBench frame
+            all_a.append((sp[:, 0] <= 0.0).astype(np.float32)[:, None])
+        pts = torch.from_numpy(np.stack(all_p)).to(device=env.device, dtype=torch.float32).contiguous()
+        aff = torch.from_numpy(np.stack(all_a)).to(device=env.device, dtype=torch.float32).contiguous()
+    sax = _compute_asset_s_ax(pts, aff)
+    env._obs_asset_pts = pts
+    env._obs_asset_afford = aff
+    env._obs_asset_s_ax = sax
+    return pts, aff, sax
+
+
+def _compute_pointcloud_obs(
+    env,
+    obj_pos: torch.Tensor,
+    obj_rot: torch.Tensor,
+    goal_pos: torch.Tensor,
+    goal_rot: torch.Tensor,
+    palm_pos: torch.Tensor,
+) -> torch.Tensor:
+    """Return (N, 128, 8) tensor: [curr_pts - palm_pos, afford_mask, s_ax, goal_pts - curr_pts]."""
+    asset_pts, asset_aff, asset_sax = _ensure_obs_pointcloud_buffers(env)
+    aidx = env._object_asset_index_per_env
+    local_pts = asset_pts[aidx]      # (N, 128, 3)
+    aff_mask = asset_aff[aidx]       # (N, 128, 1)
+    s_ax = asset_sax[aidx]           # (N, 128, 1)
+    n, m, _ = local_pts.shape
+
+    q_obj = obj_rot.unsqueeze(1).expand(n, m, 4).reshape(-1, 4)
+    q_goal = goal_rot.unsqueeze(1).expand(n, m, 4).reshape(-1, 4)
+    flat_pts = local_pts.reshape(-1, 3)
+
+    curr_pts = quat_apply(q_obj, flat_pts).reshape(n, m, 3) + obj_pos.unsqueeze(1)
+    goal_pts = quat_apply(q_goal, flat_pts).reshape(n, m, 3) + goal_pos.unsqueeze(1)
+    rel_palm = curr_pts - palm_pos.unsqueeze(1)
+    to_goal = goal_pts - curr_pts
+    return torch.cat([rel_palm, aff_mask, s_ax, to_goal], dim=-1)
+
