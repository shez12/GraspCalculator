@@ -0,0 +1,461 @@
+"""Offline preprocessing of OakInk-Shape + OakBase tool assets for SimToolReal.
+
+For each selected OakInk tool object:
+  1. Loads the OakInk mesh and strips any support plate via OakBase part clouds.
+  2. Canonicalizes its frame (X = long axis handle->head, Y = second axis,
+     Z = thinnest axis so it lies flat on the table) and records T_canon (4x4)
+     so OakInk grasps can be mapped directly into the canonical frame.
+  3. Runs CoACD convex decomposition to build an Isaac-Sim-ready URDF with
+     explicit <mass> and <inertia>.
+  4. Samples N surface points with normals, OakBase part IDs, and binary
+     affordance mask (held_by_hand / trigger) for PointNet and grasp scoring.
+  5. Writes manifest.json and a consolidated asset_clouds.pt for fast GPU load.
+
+Usage:
+    PYTHONPATH=/home/szc/work/newsimtoolreal/simtoolreal:/home/szc/work/graspcalculator \
+    /home/szc/.conda/envs/simtoolreal_isaacsim/bin/python \
+        isaacsimenvs/tasks/simtoolreal/utils/prepare_oakink_assets.py \
+        --out_dir /home/szc/data/simtoolreal_oakink_assets \
+        --max_per_cat 16 --workers 8
+"""
+
+from __future__ import annotations
+
+import argparse
+import glob
+import json
+import os
+import sys
+import xml.etree.ElementTree as ET
+import multiprocessing as mp
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from pathlib import Path
+
+import numpy as np
+import torch
+import trimesh
+from scipy.spatial import cKDTree
+
+REPO_ROOT = Path(__file__).resolve().parents[4]
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+GRASPCALC_ROOT = Path("/home/szc/work/graspcalculator")
+if str(GRASPCALC_ROOT) not in sys.path:
+    sys.path.insert(0, str(GRASPCALC_ROOT))
+
+from dextoolbench.run_coacd import run_coacd
+from graspcalc.oakink import load_mesh
+from graspcalc.paths import OAKBASE_DIR, SHAPE_DIR
+
+DEFAULT_TOOL_CATEGORIES = (
+    "hammer",
+    "screwdriver",
+    "pen",
+    "knife",
+    "scissors",
+    "toothbrush",
+    "flashlight",
+    "fryingpan",
+    "power_drill",
+    "trigger_sprayer",
+    "wrench",
+    "pincer",
+)
+
+OAKBASE_CAT_MAP = {
+    "pen": "marker",
+    "scissors": "scissor",
+    "fryingpan": "frying_pan",
+    "cameras": "camera",
+    "gamecontroller": "game_controller",
+    "lotion_pump": "lotion_bottle",
+    "squeezable": "squeeze_tube",
+}
+
+
+def resolve_oakbase_cat(cat: str) -> str:
+    if os.path.isdir(os.path.join(OAKBASE_DIR, cat)):
+        return cat
+    return OAKBASE_CAT_MAP.get(cat, cat)
+
+
+def load_oakbase_parts(ob_cat: str, obj_name: str):
+    """Return list of (short_name, attrs_list, points_np) for an OakBase object."""
+    part_dir = os.path.join(OAKBASE_DIR, ob_cat, obj_name)
+    files = sorted(glob.glob(os.path.join(part_dir, "part_*.json")))
+    if not files:
+        return []
+    parts = []
+    for jf in files:
+        meta = json.load(open(jf))
+        raw_name = meta.get("name", "")
+        short = raw_name[len(ob_cat) + 1 :] if raw_name.startswith(ob_cat + "_") else raw_name
+        attrs = meta.get("attr", [])
+        if isinstance(attrs, str):
+            attrs = [attrs]
+        ply = jf[:-5] + ".ply"
+        pts = np.asarray(trimesh.load(ply, process=False).vertices, dtype=np.float64)
+        parts.append((short, attrs, pts))
+    return parts
+
+
+def is_affordance_part(cat: str, short_name: str, attrs: list[str]) -> bool:
+    """Identify the functional grasp part for a tool category."""
+    if cat == "trigger_sprayer":
+        return short_name in ("trigger", "closure") or "trigger" in short_name
+    if "held_by_hand" in attrs:
+        if short_name in ("body", "bottle_body", "mug_body", "teapot_body", "pan_body"):
+            return False
+        return True
+    return any(k in short_name for k in ("grip", "handle", "pen_body"))
+
+
+def canonicalize_transform(
+    pts: np.ndarray,
+    afford_mask: np.ndarray,
+) -> np.ndarray:
+    """Build right-handed 4x4 T_canon mapping original OakInk frame -> canonical frame.
+
+    Canonical convention (matching DexToolBench):
+      - Origin at bounding-box midpoint in canonical frame
+      - +X = longest principal axis, oriented handle (-X) -> working end (+X)
+      - +Y = second principal axis
+      - +Z = thinnest principal axis (tool rests flat on table)
+    """
+    center = pts.mean(axis=0)
+    centered = pts - center
+    cov = np.cov(centered.T)
+    eigvals, eigvecs = np.linalg.eigh(cov)
+    order = np.argsort(eigvals)[::-1]
+    R = eigvecs[:, order].T  # rows are new axes in original frame
+
+    if afford_mask.any() and (~afford_mask).any():
+        aff_x = (centered[afford_mask] @ R[0]).mean()
+        wrk_x = (centered[~afford_mask] @ R[0]).mean()
+        if wrk_x < aff_x:
+            R[0] = -R[0]
+
+    if np.linalg.det(R) < 0:
+        R[2] = -R[2]
+
+    rot_pts = pts @ R.T
+    bbox_mid = 0.5 * (rot_pts.min(axis=0) + rot_pts.max(axis=0))
+    t = -bbox_mid
+
+    T = np.eye(4, dtype=np.float64)
+    T[:3, :3] = R
+    T[:3, 3] = t
+    return T
+
+
+def build_urdf(
+    urdf_path: Path,
+    obj_name: str,
+    visual_rel: str,
+    collision_rels: list[str],
+    parts: list[trimesh.Trimesh],
+    density: float = 200.0,
+    min_mass: float = 0.05,
+    max_mass: float = 0.15,
+) -> float:
+    """Write an Isaac-Sim-ready URDF with explicit <mass> and <inertia>."""
+    combined = trimesh.util.concatenate(parts)
+    combined.density = density
+    raw_mass = float(combined.mass)
+    if not np.isfinite(raw_mass) or raw_mass <= 1e-6:
+        raw_mass = 0.12
+    mass = float(np.clip(raw_mass, min_mass, max_mass))
+    scale_inertia = mass / max(raw_mass, 1e-6)
+    com = combined.center_mass
+    if not np.all(np.isfinite(com)):
+        com = np.zeros(3)
+    it = combined.moment_inertia * scale_inertia
+    if not np.all(np.isfinite(it)):
+        it = np.eye(3) * (mass * 0.002)
+    for i in range(3):
+        it[i, i] = max(float(it[i, i]), 1e-5)
+
+    robot = ET.Element("robot", name=obj_name)
+    link = ET.SubElement(robot, "link", name="object")
+
+    inertial = ET.SubElement(link, "inertial")
+    ET.SubElement(inertial, "origin", xyz=f"{com[0]:.6g} {com[1]:.6g} {com[2]:.6g}", rpy="0 0 0")
+    ET.SubElement(inertial, "mass", value=f"{mass:.6g}")
+    ET.SubElement(
+        inertial,
+        "inertia",
+        ixx=f"{it[0, 0]:.6g}",
+        ixy=f"{it[0, 1]:.6g}",
+        ixz=f"{it[0, 2]:.6g}",
+        iyy=f"{it[1, 1]:.6g}",
+        iyz=f"{it[1, 2]:.6g}",
+        izz=f"{it[2, 2]:.6g}",
+    )
+
+    vis = ET.SubElement(link, "visual")
+    ET.SubElement(vis, "origin", xyz="0 0 0", rpy="0 0 0")
+    vgeom = ET.SubElement(vis, "geometry")
+    ET.SubElement(vgeom, "mesh", filename=visual_rel, scale="1 1 1")
+
+    for crel in collision_rels:
+        col = ET.SubElement(link, "collision")
+        ET.SubElement(col, "origin", xyz="0 0 0", rpy="0 0 0")
+        cgeom = ET.SubElement(col, "geometry")
+        ET.SubElement(cgeom, "mesh", filename=crel, scale="1 1 1")
+
+    ET.indent(robot, space="  ")
+    ET.ElementTree(robot).write(urdf_path, encoding="utf-8", xml_declaration=True)
+    return mass
+
+
+def process_one_object(task: tuple) -> dict | None:
+    cat, ob_cat, oid, name, out_root, n_pts, max_hull, threshold = task
+    obj_out = Path(out_root) / cat / oid
+    urdf_path = obj_out / f"{oid}.urdf"
+    cloud_path = obj_out / "cloud.npz"
+    meta_path = obj_out / "meta.json"
+
+    if urdf_path.exists() and cloud_path.exists() and meta_path.exists():
+        return json.load(open(meta_path))
+
+    try:
+        mesh, _ = load_mesh(SHAPE_DIR, oid)
+    except Exception as e:
+        return {"_error": f"{cat}/{oid}: load_mesh failed: {e}"}
+
+    parts_info = load_oakbase_parts(ob_cat, name)
+    if not parts_info:
+        return {"_error": f"{cat}/{oid}: no OakBase parts"}
+
+    part_names = [p[0] for p in parts_info]
+    part_attrs = [p[1] for p in parts_info]
+    part_clouds = [p[2] for p in parts_info]
+    all_part_pts = np.concatenate(part_clouds, axis=0)
+    all_part_ids = np.concatenate(
+        [np.full(len(c), i, dtype=np.int64) for i, c in enumerate(part_clouds)]
+    )
+
+    tree = cKDTree(all_part_pts)
+    face_dists, _ = tree.query(mesh.triangles_center)
+    keep = face_dists < 0.008
+    drop_frac = 1.0 - (mesh.area_faces[keep].sum() / max(mesh.area, 1e-9))
+    if drop_frac > 0.25 or keep.sum() < 20:
+        return {"_error": f"{cat}/{oid}: OakBase covers only {(1 - drop_frac)*100:.0f}%"}
+    if drop_frac > 0.01:
+        mesh = mesh.submesh([keep], append=True)
+
+    raw_max_ext = float(mesh.extents.max())
+    if raw_max_ext < 0.04 or raw_max_ext > 0.45:
+        return {"_error": f"{cat}/{oid}: extent {raw_max_ext:.3f}m out of [0.04, 0.45]"}
+
+    afford_flags = [is_affordance_part(cat, sn, at) for sn, at in zip(part_names, part_attrs)]
+    if not any(afford_flags):
+        afford_flags = ["held_by_hand" in at for at in part_attrs]
+    if not any(afford_flags):
+        afford_flags[0] = True
+    afford_part_names = [sn for sn, f in zip(part_names, afford_flags) if f]
+
+    np.random.seed(abs(hash(oid)) % (2**32))
+    surf_pts, face_idx = trimesh.sample.sample_surface(mesh, n_pts)
+    surf_normals = np.asarray(mesh.face_normals[face_idx], dtype=np.float32)
+    _, nn_idx = tree.query(surf_pts)
+    surf_part_ids = all_part_ids[nn_idx]
+    surf_afford = np.isin(surf_part_ids, [i for i, f in enumerate(afford_flags) if f])
+
+    T_canon = canonicalize_transform(surf_pts, surf_afford)
+    R = T_canon[:3, :3]
+    t = T_canon[:3, 3]
+
+    mesh_canon = mesh.copy()
+    mesh_canon.apply_transform(T_canon)
+    pts_canon = (surf_pts @ R.T + t).astype(np.float32)
+    normals_canon = (surf_normals @ R.T).astype(np.float32)
+    n_norm = np.linalg.norm(normals_canon, axis=1, keepdims=True)
+    normals_canon = normals_canon / np.maximum(n_norm, 1e-8)
+
+    obj_out.mkdir(parents=True, exist_ok=True)
+    visual_path = obj_out / "visual.obj"
+    mesh_canon.export(visual_path)
+
+    col_dir = obj_out / "collision"
+    try:
+        hull_parts = run_coacd(
+            visual_path,
+            col_dir,
+            max_convex_hull=max_hull,
+            threshold=threshold,
+            preprocess_resolution=30,
+            resolution=1200,
+            mcts_nodes=15,
+            mcts_iterations=100,
+            mcts_max_depth=3,
+            mode="python",
+        )
+    except Exception as e:
+        return {"_error": f"{cat}/{oid}: CoACD failed: {e}"}
+
+    if not hull_parts:
+        return {"_error": f"{cat}/{oid}: CoACD returned 0 parts"}
+
+    col_files = sorted(col_dir.glob("decomp_*.obj"))
+    col_rels = [f"collision/{f.name}" for f in col_files]
+    mass = build_urdf(urdf_path, f"{cat}_{oid}", "visual.obj", col_rels, hull_parts)
+
+    extents = mesh_canon.extents.astype(np.float32)
+    min_z = float(mesh_canon.bounds[0, 2])
+    init_z_offset = float(-min_z + 0.005)
+
+    np.savez_compressed(
+        cloud_path,
+        points=pts_canon,
+        normals=normals_canon,
+        part_ids=surf_part_ids.astype(np.int64),
+        afford_mask=surf_afford.astype(np.float32),
+        extents=extents,
+    )
+
+    meta = {
+        "category": cat,
+        "oakbase_cat": ob_cat,
+        "obj_id": oid,
+        "name": name,
+        "urdf_path": str(urdf_path),
+        "cloud_path": str(cloud_path),
+        "part_names": part_names,
+        "afford_parts": afford_part_names,
+        "T_canon": T_canon.tolist(),
+        "extents": extents.tolist(),
+        "init_z_offset": init_z_offset,
+        "mass": mass,
+        "num_hulls": len(col_rels),
+    }
+    with open(meta_path, "w") as f:
+        json.dump(meta, f, indent=2)
+    return meta
+
+
+def discover_objects(categories: list[str], max_per_cat: int) -> list[tuple[str, str, str, str]]:
+    meta_r = json.load(open(os.path.join(SHAPE_DIR, "metaV2", "object_id.json")))
+    meta_v = json.load(open(os.path.join(SHAPE_DIR, "metaV2", "virtual_object_id.json")))
+    all_meta = {**meta_r, **meta_v}
+
+    tasks = []
+    for cat in categories:
+        cd = os.path.join(SHAPE_DIR, "oakink_shape_v2", cat)
+        if not os.path.isdir(cd):
+            print(f"[warn] category not in oakink_shape_v2: {cat}")
+            continue
+        ob_cat = resolve_oakbase_cat(cat)
+        real_oids = sorted(
+            {p.split(os.sep)[-3] for p in glob.glob(os.path.join(cd, "*", "*", "hand_param.pkl"))}
+        )
+        virt_oids = sorted(
+            {
+                p.split(os.sep)[-2]
+                for p in glob.glob(os.path.join(cd, "*", "*", "*", "hand_param.pkl"))
+            }
+            - set(real_oids)
+        )
+        ordered = real_oids + virt_oids
+        chosen = []
+        for oid in ordered:
+            if oid not in all_meta:
+                continue
+            name = all_meta[oid]["name"]
+            if not glob.glob(os.path.join(OAKBASE_DIR, ob_cat, name, "part_*.json")):
+                continue
+            chosen.append((cat, ob_cat, oid, name))
+            if max_per_cat > 0 and len(chosen) >= max_per_cat:
+                break
+        print(f"[discover] {cat:16s} -> {len(chosen):3d} objects (real={min(len(real_oids), len(chosen))})")
+        tasks.extend(chosen)
+    return tasks
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out_dir", default="/home/szc/data/simtoolreal_oakink_assets")
+    p.add_argument("--categories", nargs="+", default=list(DEFAULT_TOOL_CATEGORIES))
+    p.add_argument("--max_per_cat", type=int, default=16)
+    p.add_argument("--n_pts", type=int, default=256)
+    p.add_argument("--max_hull", type=int, default=32)
+    p.add_argument("--threshold", type=float, default=0.05)
+    p.add_argument("--workers", type=int, default=8)
+    args = p.parse_args()
+
+    out_dir = Path(args.out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    raw_tasks = discover_objects(args.categories, args.max_per_cat)
+    full_tasks = [
+        (cat, ob_cat, oid, name, str(out_dir), args.n_pts, args.max_hull, args.threshold)
+        for cat, ob_cat, oid, name in raw_tasks
+    ]
+
+    assets = []
+    errors = []
+    with ProcessPoolExecutor(max_workers=args.workers, mp_context=mp.get_context("spawn")) as ex:
+        futs = [ex.submit(process_one_object, t) for t in full_tasks]
+        for i, fut in enumerate(as_completed(futs), 1):
+            res = fut.result()
+            if res is None:
+                continue
+            if "_error" in res:
+                errors.append(res["_error"])
+            else:
+                assets.append(res)
+            if i % 20 == 0 or i == len(full_tasks):
+                print(f"[progress] {i}/{len(full_tasks)} ok={len(assets)} skipped={len(errors)}")
+
+    assets.sort(key=lambda a: (a["category"], a["obj_id"]))
+    categories_present = sorted({a["category"] for a in assets})
+    cat_to_id = {c: i for i, c in enumerate(categories_present)}
+
+    pts_list, nrm_list, pid_list, aff_list, ext_list, zoff_list, cid_list = [], [], [], [], [], [], []
+    for a in assets:
+        d = np.load(a["cloud_path"])
+        pts_list.append(d["points"])
+        nrm_list.append(d["normals"])
+        pid_list.append(d["part_ids"])
+        aff_list.append(d["afford_mask"])
+        ext_list.append(a["extents"])
+        zoff_list.append(a["init_z_offset"])
+        cid_list.append(cat_to_id[a["category"]])
+        a["category_id"] = cat_to_id[a["category"]]
+
+    clouds_pt = out_dir / "asset_clouds.pt"
+    torch.save(
+        {
+            "points": torch.from_numpy(np.stack(pts_list)).float(),
+            "normals": torch.from_numpy(np.stack(nrm_list)).float(),
+            "part_ids": torch.from_numpy(np.stack(pid_list)).long(),
+            "afford_mask": torch.from_numpy(np.stack(aff_list)).float(),
+            "extents": torch.tensor(ext_list, dtype=torch.float32),
+            "init_z_offset": torch.tensor(zoff_list, dtype=torch.float32),
+            "category_id": torch.tensor(cid_list, dtype=torch.long),
+            "categories": categories_present,
+        },
+        clouds_pt,
+    )
+
+    manifest = {
+        "out_dir": str(out_dir),
+        "clouds_pt": str(clouds_pt),
+        "n_pts": args.n_pts,
+        "categories": categories_present,
+        "num_assets": len(assets),
+        "assets": assets,
+    }
+    manifest_path = out_dir / "manifest.json"
+    with open(manifest_path, "w") as f:
+        json.dump(manifest, f, indent=2)
+
+    print(f"\n[done] wrote {manifest_path} ({len(assets)} assets across {len(categories_present)} categories)")
+    for c in categories_present:
+        n_c = sum(1 for a in assets if a["category"] == c)
+        print(f"  {c:16s}: {n_c}")
+    if errors:
+        print(f"[skipped {len(errors)}]:", errors[:8])
+
+
+if __name__ == "__main__":
+    main()
