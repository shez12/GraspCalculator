@@ -46,6 +46,15 @@ def main() -> None:
         default=None,
         help="Override env_cfg.peg_in_hole.goal_mode before instantiation (e.g. 'dense').",
     )
+    parser.add_argument("--dataset_manifest", default="", help="Override env_cfg.assets.dataset_manifest")
+    parser.add_argument("--human_like_goals", action="store_true", help="Enable env_cfg.reset.human_like_goals")
+    parser.add_argument("--use_pointcloud_obs", action="store_true", help="Enable env_cfg.obs.use_pointcloud_obs")
+    parser.add_argument("--use_grasp_ref_feat", action="store_true", help="Enable env_cfg.obs.use_grasp_ref_feat")
