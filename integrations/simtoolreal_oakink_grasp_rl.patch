index 00000000..5ecfd710
--- /dev/null
+++ b/isaacsimenvs/cfg/train/SimToolRealPointNetSAPG.yaml
@@ -0,0 +1,133 @@
+# SimToolReal end-to-end PointNet + LSTM + MLP SAPG training config.
+# Replaces bounding-box keypoints/scales with a 128-point object point cloud
+# (xyz_rel_palm + affordance_mask + goal_disp) encoded end-to-end by PointNet.
+
+params:
+  seed: 42
+
+  env:
+    clip_observations: 10.0
+    clip_actions: 1.0
+
+  algo:
+    name: a2c_continuous
+
+  model:
+    name: continuous_a2c_logstd
+
+  network:
+    name: pointnet_actor_critic
+    separate: False
+    pointnet:
+      num_points: 128
+      point_dim: 8
+      units: [64, 128, 128]
+      out_dim: 128
+    space:
+      continuous:
+        mu_activation: None
+        sigma_activation: None
+        mu_init:
+          name: default
+        sigma_init:
+          name: const_initializer
+          val: 0
+        fixed_sigma: coef_cond
+    mlp:
+      units: [1024, 1024, 512, 512]
+      activation: elu
+      d2rl: False
+      initializer:
+        name: default
+      regularizer:
+        name: None
+    rnn:
+      name: lstm
+      units: 1024
+      layers: 1
+      before_mlp: True
+      layer_norm: True
+
+  load_checkpoint: False
+  load_path: ''
+
+  config:
+    name: 0_simtoolreal_pointnet_sapg
+    full_experiment_name: ${.name}
+    env_name: rlgpu
+    device: 'cuda:0'
+    device_name: 'cuda:0'
+    multi_gpu: False
+    ppo: True
+    mixed_precision: True
+    normalize_input: False
+    normalize_value: True
+    value_bootstrap: True
+    normalize_advantage: True
+    per_cat_advantage_norm: False
+    per_cat_advantage_floor_ratio: 0.2
+    per_cat_advantage_clip: 8.0
+    reward_shaper:
+      scale_value: 0.01
+    num_actors: ${....env.scene.num_envs}
+    gamma: 0.99
+    tau: 0.95
+    learning_rate: 1e-4
+    lr_schedule: adaptive
+    schedule_type: standard
+    kl_threshold: 0.016
+    score_to_win: 1000000
+    max_epochs: 1000000
+    save_best_after: 100
+    save_frequency: 3000
+    print_stats: True
+    grad_norm: 1.0
+    entropy_coef: 0.0
+    truncate_grads: True
+    e_clip: 0.1
+    minibatch_size: 32768
+    mini_epochs: 2
+    critic_coef: 4.0
+    clip_value: True
+    horizon_length: 16
+    seq_length: 16
+    bounds_loss_coef: 0.0001
+
+    central_value_config:
+      minibatch_size: 32768
+      mini_epochs: 2
+      learning_rate: 1e-4
+      kl_threshold: 0.016
+      clip_value: True
+      normalize_input: False
+      truncate_grads: True
+      network:
+        name: pointnet_actor_critic
+        central_value: True
+        pointnet:
+          num_points: 128
+          point_dim: 8
+          units: [64, 128, 128]
+          out_dim: 128
+        mlp:
+          units: [1024, 1024, 512, 512]
+          activation: elu
+          d2rl: False
+          initializer:
+            name: default
+          regularizer:
+            name: None
+
+    # === SAPG ===
+    use_others_experience: lf
+    off_policy_ratio: 1.0
+    expl_type: mixed_expl_learn_param
+    expl_reward_type: entropy
+    expl_reward_coef_embd_size: 32
+    expl_reward_coef_scale: 0.002
+    expl_coef_block_size: 1024
+
+    player:
+      deterministic: False
+      games_num: 100000
+      print_stats: False
diff --git a/isaacsimenvs/play_video.py b/isaacsimenvs/play_video.py
index 846ce696..2549c124 100644
--- a/isaacsimenvs/play_video.py
