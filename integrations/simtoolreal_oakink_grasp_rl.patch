+def _euler_xyz_to_quat_wxyz(
+    roll: torch.Tensor, pitch: torch.Tensor, yaw: torch.Tensor
+) -> torch.Tensor:
+    """Convert XYZ intrinsic (roll, pitch, yaw) tensors of shape (...) to wxyz quats (..., 4)."""
+    cr, sr = torch.cos(roll * 0.5), torch.sin(roll * 0.5)
+    cp, sp = torch.cos(pitch * 0.5), torch.sin(pitch * 0.5)
+    cy, sy = torch.cos(yaw * 0.5), torch.sin(yaw * 0.5)
+    w = cr * cp * cy + sr * sp * sy
+    x = sr * cp * cy - cr * sp * sy
+    y = cr * sp * cy + sr * cp * sy
+    z = cr * cp * sy - sr * sp * cy
+    return torch.stack([w, x, y, z], dim=-1)
+
+
+def sample_human_like_trajectories(
+    category_ids: torch.Tensor,          # (N,) long
+    categories: list[str],
+    num_steps: int,
+    mins: tuple[float, float, float],
+    maxs: tuple[float, float, float],
+    yaw_range_deg: float = 30.0,
+    scale_range: tuple[float, float] = (0.85, 1.15),
+    device: torch.device | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Generate category-aware human-like functional tool-use trajectories.
+
+    All tools are assumed to be in canonical frame:
+      +X = handle -> working head/tip, +Y = secondary axis, +Z = thinnest axis.
+
+    Step 0 is a lifted functional ready pose; steps 1..K-1 execute realistic
+    cyclic tool motions (hammer swing, screwdriver spin, pen draw, knife slice,
+    pan toss, sprayer/drill aim) with bounded workspace translation, yaw, and
+    amplitude randomization — no arbitrary 3D tumbling.
+
+    Returns:
+        pos:  (N, K, 3) env-local positions clamped inside workspace bounds.
+        quat: (N, K, 4) wxyz unit quaternions.
+    """
+    dev = device or category_ids.device
+    n = category_ids.shape[0]
+    k = num_steps
+
+    # Phase parameter u in [0, 1] across the K steps; step 0 is u=0 (ready pose).
+    u = torch.linspace(0.0, 1.0, k, device=dev, dtype=torch.float32).unsqueeze(0).expand(n, k)
+    cycles = 2.0 * math.pi * u
+
+    # Per-env randomization: workspace anchor, yaw offset, amplitude scale, variant bit
+    anchor = torch.stack(
+        [
+            torch.empty(n, device=dev).uniform_(-0.08, 0.12),
+            torch.empty(n, device=dev).uniform_(-0.04, 0.10),
+            torch.empty(n, device=dev).uniform_(0.66, 0.74),
+        ],
+        dim=-1,
+    )  # (N, 3)
+    yaw_off = torch.empty(n, device=dev).uniform_(-yaw_range_deg, yaw_range_deg) * (
+        math.pi / 180.0
+    )
+    amp = torch.empty(n, device=dev).uniform_(scale_range[0], scale_range[1]).unsqueeze(1)  # (N, 1)
+    variant = torch.rand(n, device=dev) > 0.5  # (N,) bool for dual-mode tools
+
+    # Local trajectory offsets (dx, dy, dz) and Euler angles (roll, pitch, yaw)
+    dx = torch.zeros(n, k, device=dev)
+    dy = torch.zeros(n, k, device=dev)
+    dz = torch.zeros(n, k, device=dev)
+    roll = torch.zeros(n, k, device=dev)
+    pitch = torch.zeros(n, k, device=dev)
+    yaw = torch.zeros(n, k, device=dev)
+
+    # Default functional motion: gentle forward-back aiming sweep (drill, sprayer, flashlight)
+    dx = 0.05 * amp * torch.sin(cycles)
+    dy = 0.04 * amp * torch.sin(2.0 * cycles)
+    dz = 0.02 * amp * torch.cos(cycles)
+    pitch = 0.18 * torch.sin(cycles)
+    yaw = 0.25 * torch.sin(cycles)
+
+    for cid, cat in enumerate(categories):
+        m = category_ids == cid
+        if not m.any():
+            continue
+        c_u = cycles[m]
+        c_amp = amp[m]
+        c_var = variant[m].unsqueeze(1)
+
+        if cat == "hammer":
+            # Variant 0: swing_down (vertical strike arc); Variant 1: swing_side (lateral arc)
+            down_dx = -0.06 * c_amp * torch.sin(c_u)
+            down_dy = 0.02 * c_amp * torch.sin(c_u)
+            down_dz = 0.05 * c_amp * torch.cos(c_u)
+            down_pitch = 0.30 * torch.sin(c_u)
+            down_yaw = torch.zeros_like(c_u)
+
+            side_dx = 0.05 * c_amp * torch.sin(c_u)
+            side_dy = 0.06 * c_amp * torch.cos(c_u)
+            side_dz = 0.02 * c_amp * torch.sin(c_u)
+            side_pitch = torch.zeros_like(c_u)
+            side_yaw = 0.25 * torch.sin(c_u)
+
+            dx[m] = torch.where(c_var, side_dx, down_dx)
+            dy[m] = torch.where(c_var, side_dy, down_dy)
+            dz[m] = torch.where(c_var, side_dz, down_dz)
+            roll[m] = 0.0
+            pitch[m] = torch.where(c_var, side_pitch, down_pitch)
+            yaw[m] = torch.where(c_var, side_yaw, down_yaw)
+
+        elif cat in ("screwdriver", "wrench"):
+            # Gentle wrist turn within left-hand comfortable kinematic range
+            base_pitch = torch.where(c_var, torch.full_like(c_u, 0.0), torch.full_like(c_u, 0.35))
+            dx[m] = 0.015 * c_amp * torch.sin(c_u)
+            dy[m] = 0.015 * c_amp * torch.cos(c_u)
+            dz[m] = 0.02 * c_amp * torch.sin(0.5 * c_u)
+            roll[m] = 0.40 * torch.sin(2.0 * c_u)
+            pitch[m] = base_pitch
+            yaw[m] = 0.10 * torch.sin(c_u)
+
+        elif cat in ("pen", "marker", "toothbrush"):
+            # Writing / brushing: mild tilt (~17 deg), smooth arc in XY, keep above table
+            dx[m] = 0.07 * c_amp * torch.sin(c_u)
+            dy[m] = 0.05 * c_amp * torch.sin(2.0 * c_u)
+            dz[m] = 0.015 * c_amp * torch.cos(2.0 * c_u)
+            roll[m] = 0.12 * torch.sin(c_u)
+            pitch[m] = 0.30 + 0.08 * torch.sin(c_u)
+            yaw[m] = 0.15 * torch.sin(c_u)
+
+        elif cat in ("knife", "scissors", "pincer"):
+            # Slicing / cutting: back-and-forth along tool axis with gentle pitch rocking, keep above table
+            dx[m] = 0.07 * c_amp * torch.sin(2.0 * c_u)
+            dy[m] = 0.025 * c_amp * torch.sin(c_u)
+            dz[m] = 0.02 * c_amp * torch.cos(2.0 * c_u)
+            roll[m] = 0.0
+            pitch[m] = 0.18 * torch.sin(2.0 * c_u)
+            yaw[m] = 0.15 * torch.sin(c_u)
+
+        elif cat == "fryingpan":
+            # Level pan with gentle toss / lift-and-tilt arc
+            dx[m] = 0.06 * c_amp * torch.sin(c_u)
+            dy[m] = 0.04 * c_amp * torch.cos(c_u)
+            dz[m] = 0.04 * c_amp * torch.sin(2.0 * c_u)
+            roll[m] = 0.12 * torch.sin(c_u)
+            pitch[m] = -0.18 * torch.sin(2.0 * c_u)
+            yaw[m] = 0.15 * torch.sin(c_u)
+
+        elif cat in ("power_drill", "trigger_sprayer", "flashlight"):
+            # Aimed steady forward/slightly down with controlled pan & trigger/aim position
+            dx[m] = 0.04 * c_amp * torch.sin(c_u)
+            dy[m] = 0.06 * c_amp * torch.sin(c_u)
+            dz[m] = 0.03 * c_amp * torch.cos(c_u)
+            roll[m] = 0.0
+            pitch[m] = 0.10 + 0.10 * torch.sin(c_u)
+            yaw[m] = 0.20 * torch.sin(c_u)
+
+    # Rotate local XY displacement by per-env yaw_off and add anchor
+    cy = torch.cos(yaw_off).unsqueeze(1)
+    sy = torch.sin(yaw_off).unsqueeze(1)
+    rx = cy * dx - sy * dy
+    ry = sy * dx + cy * dy
+
+    pos = torch.stack(
+        [anchor[:, 0:1] + rx, anchor[:, 1:2] + ry, anchor[:, 2:3] + dz],
+        dim=-1,
+    )
+    mins_t = torch.as_tensor(mins, device=dev, dtype=torch.float32)
+    maxs_t = torch.as_tensor(maxs, device=dev, dtype=torch.float32)
+    pos = torch.clamp(pos, mins_t, maxs_t)
+
+    # Apply global yaw_off around Z
+    quat_local = _euler_xyz_to_quat_wxyz(roll, pitch, yaw + yaw_off.unsqueeze(1))
+    quat_local = torch.nn.functional.normalize(quat_local, dim=-1)
+    return pos, quat_local
+
+
+__all__ = [
+    "sample_absolute_goal_pose",
+    "sample_delta_goal_pose",
+    "sample_human_like_trajectories",
+]
